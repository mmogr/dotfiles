// Greeting shown by fish_greeting (see fish/.config/fish/config.fish).
// Keep the info lines short: fish picks the logo size from the terminal
// width, and fastfetch truncates anything that does not fit beside it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    { "type": "os", "format": "{name} {arch}" },
    { "type": "host", "format": "{family}" },
    { "type": "kernel", "format": "{release}" },
    "uptime",
    "packages",
    {
      "type": "command",
      "key": "AUR",
      "text": "command -v paru >/dev/null && paru -Qm | wc -l"
    },
    { "type": "shell", "format": "{pretty-name} {version}" },
    { "type": "display", "key": "Display", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "de", "key": "DE", "format": "{pretty-name} {version}" },
    { "type": "wm", "key": "WM", "format": "{pretty-name} ({protocol-name})" },
    "terminal",
    { "type": "cpu", "format": "{name}" },
    { "type": "gpu", "format": "{name}" },
    { "type": "memory", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "folders": "/", "key": "Disk", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery", "format": "{capacity} ({status})" },
    "break",
    "colors"
  ]
}
