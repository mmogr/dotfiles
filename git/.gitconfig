# Git global config — tracked in dotfiles, managed by stow
#
# Identity (name, email) is intentionally NOT stored here to keep this file
# safe to commit to a public repo. Set it in ~/.gitconfig-local:
#
#   [user]
#       name  = Your Name
#       email = you@example.com
#
# `just git::init` creates ~/.gitconfig-local if it doesn't exist, asking for both
# values (or writing placeholders when there is no terminal).

[include]
    path = ~/.gitconfig-local

# ── Credentials ───────────────────────────────────────────────────────────────
# Delegate to the gh CLI for GitHub token auth (gh is installed by mise: just mise::install)
[credential "https://github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/env gh auth git-credential

# ── Defaults ──────────────────────────────────────────────────────────────────
[init]
    defaultBranch = main

[pull]
    rebase = false

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram

# ── Useful aliases ────────────────────────────────────────────────────────────
[alias]
    lg   = log --oneline --graph --decorate --all
    st   = status -sb
    co   = checkout
    br   = branch -vv
    undo = reset --soft HEAD~1
