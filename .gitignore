# Local secrets for Open WebUI deployment
open-webui/.config/open-webui/.env
open-webui/.config/open-webui/.env.local

# Per-machine git identity (name, email) — managed by `just git::init`
git/.gitconfig-local

*/.DS_Store
# Per-machine mise tools — `just profile` writes these to ~/.config/mise/conf.d,
# which was this directory on machines stowed before --no-folding
mise/.config/mise/conf.d/
