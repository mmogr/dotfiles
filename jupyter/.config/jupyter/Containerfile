# JupyterLab Polyglot Container
#
# Languages: Python (ipykernel), Rust (evcxr_jupyter), Java (dflib/jjava)
# SQL:       JupySQL (%sql / %%sql magics) via SQLAlchemy
# Polyglot:  SoS Notebook kernel + jupyterlab_sos JupyterLab 4.x extension
# Envs:      nb_conda_kernels — any conda env with ipykernel auto-appears as kernel
# Runtime:   Rootless Podman — jovyan (UID 1000) with :U volume remapping

# Base image: Renovate pins and refreshes the digest for this tag (see renovate.json).
FROM quay.io/jupyter/minimal-notebook:ubuntu-22.04@sha256:1a71fc04b26ede434ef16bf25e323cbfa3d0e46469eb518d0fd9e5b9e312e869

# ── Pinned versions ───────────────────────────────────────────────────────────
# Each ARG carries a renovate comment so version bumps arrive as PRs.
# renovate: datasource=github-releases depName=dflib/jjava versioning=loose
ARG JJAVA_VERSION=1.0-M3
# renovate: datasource=crate depName=evcxr_jupyter
ARG EVCXR_VERSION=0.22.0
# renovate: datasource=github-releases depName=quarto-dev/quarto-cli
ARG QUARTO_VERSION=1.10.18

# ── 1. Root layer: system packages ───────────────────────────────────────────
USER root

RUN apt-get update --quiet && \
    apt-get install --yes --no-install-recommends \
        openjdk-21-jdk-headless \
        build-essential \
        cmake \
        pkg-config \
        libssl-dev \
        unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── 2. Root layer: install JJava kernel (dflib/jjava 1.0-a7) ─────────────────
# Installed system-wide so the kernelspec is visible to the jovyan user.
RUN curl -fsSL \
        "https://github.com/dflib/jjava/releases/download/${JJAVA_VERSION}/jjava-${JJAVA_VERSION}-kernelspec.zip" \
        -o /tmp/jjava.zip && \
    unzip /tmp/jjava.zip -d /tmp/jjava && \
    jupyter kernelspec install \
        /tmp/jjava \
        --name=java && \
    rm -rf /tmp/jjava /tmp/jjava.zip

# Pre-create jovyan's Jupyter/IPython data directories as root and set correct
# ownership. Conda operations in the base image can create ~/.local and
# ~/.ipython owned by root, causing EACCES and "not a writable location"
# warnings when evcxr_jupyter --install and IPython run as jovyan.
RUN mkdir -p /home/jovyan/.local/share/jupyter/kernels \
             /home/jovyan/.ipython && \
    chown -R "${NB_UID}:${NB_GID}" \
             /home/jovyan/.local \
             /home/jovyan/.ipython

# ── 3. Jovyan layer: Rust toolchain ──────────────────────────────────────────
USER ${NB_UID}

ENV RUSTUP_HOME=/home/jovyan/.rustup
ENV CARGO_HOME=/home/jovyan/.cargo
ENV PATH="/home/jovyan/.cargo/bin:${PATH}"

RUN curl -fsSL https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal && \
    rustup component add rust-src

# ── 4. Jovyan layer: build and register evcxr_jupyter ────────────────────────
# --version pins the crate (EVCXR_VERSION above) and --locked uses the exact
# Cargo.lock published with it, so the build is reproducible. rust-src (added
# above) is required for evcxr's incremental compilation model. This layer is
# the expensive one (~15 min first build); the Docker/Podman cache keeps it
# fast on later rebuilds unless the Rust or evcxr version changes.
RUN cargo install --locked --version "${EVCXR_VERSION}" evcxr_jupyter && \
    evcxr_jupyter --install

# ── 5. Jovyan layer: Python packages + SoS kernel registration ───────────────
# Uses mamba (already in the base image) instead of pip so all packages come
# from conda-forge with pre-built binaries and consistent solver resolution.
# --no-prune preserves jupyterlab, notebook, and other base-image packages.
# environment.yml is stowed alongside this Containerfile — edit it to add/remove
# packages; the cargo layer above is unaffected (no cache bust for Rust).
COPY environment.yml /tmp/environment.yml
RUN mamba env update -n base -f /tmp/environment.yml && \
    mamba clean --all -f -y && \
    python -m sos_notebook.install

# ── 6. Root layer: Quarto CLI ────────────────────────────────────────────────
# Pinned via QUARTO_VERSION above (Renovate bumps it). dpkg --print-architecture
# picks the right asset (amd64/arm64) for the build host. curl -f makes a bad
# version fail here rather than at apt install.
USER root
RUN QUARTO_ARCH=$(dpkg --print-architecture) && \
    curl -fsSL "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${QUARTO_ARCH}.deb" \
        -o /tmp/quarto.deb && \
    apt-get update --quiet && \
    apt-get install --yes --no-install-recommends /tmp/quarto.deb && \
    apt-get clean && \
    rm -rf /tmp/quarto.deb /var/lib/apt/lists/*

# ── 7. Jovyan layer: TinyTeX (minimal LaTeX distribution, needed for PDF output) ──
USER ${NB_UID}
RUN quarto install tinytex --no-prompt

# ── 8. Build-time sanity check ───────────────────────────────────────────────
# Fails the build immediately if any kernel was not registered correctly.
RUN jupyter kernelspec list && quarto check
